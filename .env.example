# Copy to .env and fill in. Never commit .env.
POSTGRES_DB=sakay
POSTGRES_USER=sakay
POSTGRES_PASSWORD=change-me
POSTGRES_PORT=5432

# Used by the back-end
DATABASE_URL=postgresql://sakay:change-me@localhost:5432/sakay
JWT_SECRET=change-me-to-a-long-random-string
PROLOG_RULES_PATH=../prolog/routes.pl
